/** VEXORA Pro OS - Google Apps Script hosted backend.
 * Run as the deploying owner. Spreadsheet ID is stored in Script Properties.
 * Passwords are salted + iteratively SHA-256 hashed; plaintext is never stored.
 */
const VX={DB_KEY:"VEXORA_SPREADSHEET_ID",SESSION_PREFIX:"VX_SESSION_",SESSION_TTL:21600,ITERATIONS:12000};
const COLLECTIONS=["customers","subscriptions","products","sales","expenses","activity"];
function doGet(){ensureDatabase_();return HtmlService.createTemplateFromFile("Index").evaluate().setTitle("VEXORA Pro OS").addMetaTag("viewport","width=device-width, initial-scale=1").setXFrameOptionsMode(HtmlService.XFrameOptionsMode.DEFAULT);}
function include(name){return HtmlService.createHtmlOutputFromFile(name).getContent();}
function ensureDatabase_(){const props=PropertiesService.getScriptProperties();let id=props.getProperty(VX.DB_KEY);if(!id){const ss=SpreadsheetApp.create("VEXORA Pro OS Database");id=ss.getId();props.setProperty(VX.DB_KEY,id);}const ss=SpreadsheetApp.openById(id);ensureSheet_(ss,"Users",["user_id","username","password_hash","salt","role","status","created_at","updated_at"]);ensureSheet_(ss,"Workspace",["record_key","json_value","revision"]);["Customers","Subscriptions","Products","Sales","Expenses","Activity_Logs"].forEach(n=>ensureSheet_(ss,n,["record_id","json_value","updated_at"]));return ss;}
function ensureSheet_(ss,name,headers){let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);if(sh.getLastRow()===0){sh.getRange(1,1,1,headers.length).setValues([headers]);sh.setFrozenRows(1);sh.getRange(1,1,1,headers.length).setFontWeight("bold");}return sh;}
function getAuthStatus(){const ss=ensureDatabase_(),sh=ss.getSheetByName("Users");return{needsBootstrap:sh.getLastRow()<2};}
function bootstrapOwner(username,password){username=cleanUsername_(username);validatePassword_(password);const lock=LockService.getScriptLock();lock.waitLock(15000);try{const ss=ensureDatabase_(),sh=ss.getSheetByName("Users");if(sh.getLastRow()>1)throw new Error("Workspace already initialized. Please sign in.");const salt=Utilities.getUuid()+Utilities.getUuid();const now=new Date().toISOString(),id=Utilities.getUuid();sh.appendRow([id,username,hashPassword_(password,salt),salt,"CEO","ACTIVE",now,now]);const token=createSession_({id,username,role:"CEO"});return{token:token,user:{username:username,role:"CEO"},data:readState_(ss)};}finally{lock.releaseLock();}}
function login(username,password){username=cleanUsername_(username);if(typeof password!=="string"||!password)throw new Error("Enter your username and password.");const sh=ensureDatabase_().getSheetByName("Users"),rows=sh.getDataRange().getValues();for(let i=1;i<rows.length;i++){const r=rows[i];if(String(r[1]).toLowerCase()===username&&r[5]==="ACTIVE"){const candidate=hashPassword_(password,String(r[3]));if(constantTimeEqual_(candidate,String(r[2]))){const user={id:String(r[0]),username:String(r[1]),role:String(r[4])};return{token:createSession_(user),user:user};}}}throw new Error("Invalid username or password.");}
function logout(token){if(token)CacheService.getScriptCache().remove(sessionKey_(token));return true;}
function getWorkspace(token){const user=requireSession_(token);const ss=ensureDatabase_(),sh=ss.getSheetByName("Workspace");const revision=sh.getLastRow()>1?String(sh.getRange(2,3).getValue()):"0";return{data:readState_(ss),revision:revision,user:{username:user.username,role:user.role}};}
function apiSaveState(token,data,clientRevision){requireSession_(token);if(!data||typeof data!=="object")throw new Error("Invalid workspace payload.");const lock=LockService.getScriptLock();lock.waitLock(20000);try{const ss=ensureDatabase_(),sh=ss.getSheetByName("Workspace");const current=sh.getLastRow()>1?String(sh.getRange(2,3).getValue()):"0";if(String(clientRevision||"0")!==current)throw new Error("SYNC_CONFLICT: Newer cloud data exists. Refreshing workspace.");const revision=String(Date.now())+"-"+Utilities.getUuid().slice(0,8);const clean=sanitizeState_(data);const map={customers:"Customers",subscriptions:"Subscriptions",products:"Products",sales:"Sales",expenses:"Expenses",activity:"Activity_Logs"};Object.keys(map).forEach(key=>{const tab=ss.getSheetByName(map[key]);if(tab.getLastRow()>1)tab.getRange(2,1,tab.getLastRow()-1,3).clearContent();const rows=clean[key].map(item=>[String(item.id||item.customerId||Utilities.getUuid()),JSON.stringify(item),new Date().toISOString()]);if(rows.length)tab.getRange(2,1,rows.length,3).setValues(rows);});const settings=JSON.stringify(clean.settings);if(sh.getLastRow()<2)sh.appendRow(["settings",settings,revision]);else sh.getRange(2,1,1,3).setValues([["settings",settings,revision]]);return{ok:true,revision:revision};}finally{lock.releaseLock();}}
function readState_(ss){const sh=ss.getSheetByName("Workspace");const base=defaultState_();if(sh.getLastRow()>1){try{base.settings=JSON.parse(sh.getRange(2,2).getValue())||base.settings;}catch(e){throw new Error("Workspace settings could not be read: "+e.message);}}const map={customers:"Customers",subscriptions:"Subscriptions",products:"Products",sales:"Sales",expenses:"Expenses",activity:"Activity_Logs"};Object.keys(map).forEach(key=>{const tab=ss.getSheetByName(map[key]);if(tab&&tab.getLastRow()>1){const values=tab.getRange(2,2,tab.getLastRow()-1,1).getValues();base[key]=values.map(row=>{try{return JSON.parse(row[0]);}catch(e){return null;}}).filter(Boolean);}});return base;}
