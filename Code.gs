function sanitizeState_(d){const out=defaultState_();out.settings=d.settings&&typeof d.settings==="object"?d.settings:out.settings;COLLECTIONS.forEach(k=>{out[k]=Array.isArray(d[k])?d[k]:[];});return out;}
function createAccount(token,username,password,role){const actor=requireSession_(token);if(actor.role!=="CEO")throw new Error("Only a CEO can create accounts.");username=cleanUsername_(username);validatePassword_(password);role=String(role||"").toUpperCase();if(!["CEO","ADMIN"].includes(role))throw new Error("Role must be CEO or ADMIN.");const lock=LockService.getScriptLock();lock.waitLock(15000);try{const sh=ensureDatabase_().getSheetByName("Users"),rows=sh.getDataRange().getValues();let ceos=0,admins=0;for(let i=1;i<rows.length;i++){if(rows[i][4]==="CEO"&&rows[i][5]==="ACTIVE")ceos++;if(rows[i][4]==="ADMIN"&&rows[i][5]==="ACTIVE")admins++;if(String(rows[i][1]).toLowerCase()===username)throw new Error("Username already exists.");}if(role==="CEO"&&ceos>=2)throw new Error("Only two CEO accounts are allowed.");if(role==="ADMIN"&&admins>=1)throw new Error("Only one active Admin account is allowed.");const salt=Utilities.getUuid()+Utilities.getUuid(),now=new Date().toISOString();sh.appendRow([Utilities.getUuid(),username,hashPassword_(password,salt),salt,role,"ACTIVE",now,now]);return{ok:true,username:username,role:role};}finally{lock.releaseLock();}}
function requireSession_(token){if(typeof token!=="string"||token.length<30)throw new Error("Session expired. Please sign in again.");const raw=CacheService.getScriptCache().get(sessionKey_(token));if(!raw)throw new Error("Session expired. Please sign in again.");return JSON.parse(raw);}
function createSession_(user){const token=Utilities.getUuid().replace(/-/g,"")+Utilities.getUuid().replace(/-/g,"");CacheService.getScriptCache().put(sessionKey_(token),JSON.stringify(user),VX.SESSION_TTL);return token;}
function sessionKey_(token){return VX.SESSION_PREFIX+Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,token).map(b=>("0"+(b&255).toString(16)).slice(-2)).join("").slice(0,40);}
function cleanUsername_(v){const s=String(v||"").trim();if(!/^[a-zA-Z0-9._-]{4,32}$/.test(s))throw new Error("Username must be 4-32 characters using letters, numbers, dot, underscore or hyphen.");return s;}
function validatePassword_(p){if(typeof p!=="string"||p.length<12||p.length>128)throw new Error("Password must be 12-128 characters.");}
function hashPassword_(password,salt){let bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,salt+"|"+password);for(let i=1;i<VX.ITERATIONS;i++)bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,bytes.concat(Utilities.newBlob(String(i)).getBytes()));return bytes.map(b=>("0"+(b&255).toString(16)).slice(-2)).join("");}
function constantTimeEqual_(a,b){if(a.length!==b.length)return false;let n=0;for(let i=0;i<a.length;i++)n|=a.charCodeAt(i)^b.charCodeAt(i);return n===0;}
